# Copy this file to .env.local and fill in the values.
# .env.local is git-ignored: never commit real secrets.

# PostgreSQL connection string
DATABASE_URL=postgres://portal:portal-dev-pass@localhost:5432/student_portal

# 32 random bytes, base64. Encrypts the 2FA secrets stored in the database.
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# If you lose this key, enrolled 2FA secrets can no longer be read (admins can use admin:reset-2fa).
APP_ENCRYPTION_KEY=

# Session lifetimes
SESSION_HOURS=8
SESSION_IDLE_MINUTES=60

# true only when the app is served over HTTPS (secure cookies). Leave unset in local dev.
# COOKIE_SECURE=true

# true only when the app runs behind your own reverse proxy that sets X-Forwarded-For.
# Enables per-IP brute-force limits. Never enable it when the app is exposed directly.
# TRUST_PROXY=true
