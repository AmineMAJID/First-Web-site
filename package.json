{
  "name": "student-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "next start -H 0.0.0.0",
    "lint": "eslint",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/migrate.js",
    "admin:create": "node --env-file-if-exists=.env.local scripts/create-admin.js",
    "admin:reset-2fa": "node --env-file-if-exists=.env.local scripts/reset-2fa.js",
    "test": "node --env-file-if-exists=.env.local --test --test-concurrency=1 tests/auth.test.js tests/api.test.js tests/permissions.test.js tests/school.test.js tests/scope.test.js tests/family.test.js tests/notifications.test.js",
    "codes:generate": "node --env-file-if-exists=.env.local scripts/generate-codes.js",
    "admin:reset-password": "node --env-file-if-exists=.env.local scripts/reset-password.js"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "eslint": "^9",
    "eslint-config-next": "16.1.6"
  },
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  }
}
